{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "3.0",
  "brand": "Fastn",
  "philosophy": "Color is punctuation, not prose. One accent — Electric Indigo — used only on primary CTAs, inline links, and focus rings. Everything else is warm grayscale. Hierarchy comes from weight and spacing, never from a second color.",
  "colors": {
    "accent": {
      "DEFAULT":  { "value": "#6C5CE7", "description": "Electric Indigo — the only chromatic color in the system" },
      "hover":    { "value": "#7B6CEF" },
      "pressed":  { "value": "#5A4CD6" },
      "on":       { "value": "#FFFFFF", "description": "Text on indigo surfaces" }
    },
    "dark": {
      "bg":     { "value": "#1A1918", "description": "Warm dark — brown undertone, never pure black" },
      "s1":     { "value": "#222120", "description": "Cards, row hover" },
      "s2":     { "value": "#2B2A27", "description": "Raised surfaces, selected, default border color" },
      "border": { "value": "#2B2A27" },
      "bd-hi":  { "value": "#3E3D38", "description": "Hover, focus borders" },
      "t1":     { "value": "#E3E1DA", "description": "Headings, primary text — warm off-white" },
      "t2":     { "value": "#918F86", "description": "Body" },
      "t3":     { "value": "#8A8780", "description": "Supporting, lede" },
      "t4":     { "value": "#605E56", "description": "Captions ≥18px only" }
    },
    "light": {
      "bg":     { "value": "#FFFFFF" },
      "s1":     { "value": "#FAFAF8" },
      "s2":     { "value": "#F0EFEB" },
      "border": { "value": "#E8E5DE" },
      "bd-hi":  { "value": "#D4D0C8" },
      "t1":     { "value": "#1A1816" },
      "t2":     { "value": "#4A4842" },
      "t3":     { "value": "#6F6B66" },
      "t4":     { "value": "#A8A49D" }
    },
    "semantic": {
      "success": { "value": "#10B981" },
      "warning": { "value": "#F59E0B" },
      "error":   { "value": "#EF4444" }
    }
  },
  "typography": {
    "fontFamily": {
      "DEFAULT": { "value": "'Inter', system-ui, -apple-system, sans-serif", "description": "Inter throughout — no secondary or mono typeface in the brand system" }
    },
    "scale": {
      "display": { "size": "56px", "weight": 700, "lineHeight": "1.05", "letterSpacing": "-0.03em" },
      "h1":      { "size": "42px", "weight": 700, "lineHeight": "1.10", "letterSpacing": "-0.025em" },
      "h2":      { "size": "32px", "weight": 700, "lineHeight": "1.15", "letterSpacing": "-0.02em" },
      "h3":      { "size": "24px", "weight": 600, "lineHeight": "1.25", "letterSpacing": "-0.01em" },
      "h4":      { "size": "18px", "weight": 600, "lineHeight": "1.30" },
      "body":    { "size": "16px", "weight": 400, "lineHeight": "1.60" },
      "small":   { "size": "14px", "weight": 400, "lineHeight": "1.55" }
    }
  },
  "radius": {
    "2": "6px",
    "3": "8px",
    "4": "12px",
    "full": "9999px"
  },
  "motion": {
    "duration": "160ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
