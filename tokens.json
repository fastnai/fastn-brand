{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "3.0",
  "brand": "Fastn",
  "philosophy": "Color is punctuation, not prose. One accent (the indigo gradient) used only on the primary CTA, inline links, and focus rings. Everything else is neutral grayscale. Hierarchy comes from weight and spacing, never from a second color.",
  "colors": {
    "accent": {
      "1":        { "value": "#6C5CE7", "description": "Gradient start. Inline link color in light theme (4.86 contrast on white, AA)." },
      "2":        { "value": "#8E76F2", "description": "Gradient end. Inline link color in dark theme (5.08 contrast on dark bg, AA)." },
      "gradient": { "value": "linear-gradient(90deg, #6C5CE7, #8E76F2)", "description": "Primary CTA only. White text passes AA-large (3.48) at the lighter end." },
      "glow":     { "value": "rgba(124, 92, 231, 0.45)", "description": "28px outer glow on primary CTA" },
      "on":       { "value": "#FFFFFF", "description": "Text on accent surfaces (4.86 on accent-1, 3.48 on accent-2)" }
    },
    "dark": {
      "bg":     { "value": "#18181B" },
      "s1":     { "value": "#1F1F23", "description": "Cards, inputs, secondary buttons" },
      "s2":     { "value": "#26262B", "description": "Hover" },
      "border": { "value": "#2A2A30" },
      "bd-hi":  { "value": "#3A3A42", "description": "Hover, focus borders" },
      "t1":     { "value": "#FFFFFF", "description": "Headings, primary text" },
      "t2":     { "value": "#BDBDC4", "description": "Body" },
      "t3":     { "value": "#8A8A92", "description": "Supporting" },
      "t4":     { "value": "#5C5C64", "description": "Disabled, non-text only" }
    },
    "light": {
      "bg":     { "value": "#FFFFFF" },
      "s1":     { "value": "#F4F4F6" },
      "s2":     { "value": "#EAEAEE" },
      "border": { "value": "#E4E4E8" },
      "bd-hi":  { "value": "#CFCFD5" },
      "t1":     { "value": "#18181B" },
      "t2":     { "value": "#44444A" },
      "t3":     { "value": "#6E6E76" },
      "t4":     { "value": "#A4A4AC" }
    },
    "semantic": {
      "success": { "value": "#10B981" },
      "warning": { "value": "#F59E0B" },
      "error":   { "value": "#EF4444" }
    }
  },
  "typography": {
    "fontFamily": {
      "DEFAULT": { "value": "'Inter', system-ui, -apple-system, sans-serif", "description": "Inter throughout. No secondary or mono typeface." }
    },
    "scale": {
      "display": { "size": "44px", "weight": 700, "lineHeight": "1.05", "letterSpacing": "-0.03em" },
      "h1":      { "size": "32px", "weight": 700, "lineHeight": "1.10", "letterSpacing": "-0.025em" },
      "h2":      { "size": "24px", "weight": 700, "lineHeight": "1.15", "letterSpacing": "-0.02em" },
      "h3":      { "size": "18px", "weight": 600, "lineHeight": "1.25", "letterSpacing": "-0.005em" },
      "body":    { "size": "16px", "weight": 400, "lineHeight": "1.60" },
      "small":   { "size": "14px", "weight": 400, "lineHeight": "1.55" }
    }
  },
  "radius": {
    "2": "8px",
    "3": "10px",
    "4": "14px",
    "full": "9999px"
  },
  "motion": {
    "duration": "180ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
