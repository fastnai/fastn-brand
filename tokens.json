{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "2.0",
  "brand": "Fastn",
  "colors": {
    "accent": {
      "DEFAULT":  { "value": "#4FB2FF", "description": "Fastn Blue — primary CTA, links, focus rings" },
      "hover":    { "value": "#7AC4FF" },
      "pressed":  { "value": "#2F8FD6" },
      "on":       { "value": "#06121C", "description": "Text color on Fastn Blue surfaces" },
      "tint":     { "value": "rgba(79,178,255,0.10)", "description": "Subtle accent background" },
      "faint":    { "value": "rgba(79,178,255,0.04)" }
    },
    "dark": {
      "bg":        { "value": "#0E0E10", "description": "Page background" },
      "s1":        { "value": "#111113", "description": "Cards, panels" },
      "s2":        { "value": "#1A1A1D", "description": "Raised, hover, inputs" },
      "s3":        { "value": "#222226", "description": "Selected, pressed" },
      "border":    { "value": "#2A2A2E", "description": "1px dividers" },
      "border-hi": { "value": "#3E3E44", "description": "Hover, focus rings" },
      "t1":        { "value": "#FFFFFF", "description": "Display, headings, primary" },
      "t2":        { "value": "#D6D6D8", "description": "Body text" },
      "t3":        { "value": "#9A9AA2", "description": "Lede, subhead, descriptive" },
      "t4":        { "value": "#6E6E76", "description": "Captions, metadata (≥18px or non-text only)" }
    },
    "light": {
      "bg":        { "value": "#FFFFFF" },
      "s1":        { "value": "#F7F7F8" },
      "s2":        { "value": "#EEEEF0" },
      "s3":        { "value": "#E4E4E7" },
      "border":    { "value": "#E4E4E7" },
      "border-hi": { "value": "#C9C9CF" },
      "t1":        { "value": "#0E0E10" },
      "t2":        { "value": "#2A2A2E" },
      "t3":        { "value": "#5A5A62" },
      "t4":        { "value": "#8A8A92" }
    },
    "semantic": {
      "success": { "value": "#10B981" },
      "warning": { "value": "#F59E0B" },
      "error":   { "value": "#EF4444" },
      "info":    { "value": "#4FB2FF", "description": "= Fastn Blue" }
    }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "6": "24px", "8": "32px", "12": "48px", "16": "64px",
    "20": "80px", "24": "96px"
  },
  "borderRadius": {
    "1": "4px",
    "2": "6px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "24px",
    "full": "9999px"
  },
  "typography": {
    "fontFamily": {
      "display": {
        "value": "'Geist', system-ui, -apple-system, sans-serif",
        "description": "Headings and display. Weights 400–600."
      },
      "body": {
        "value": "'Inter', system-ui, -apple-system, sans-serif",
        "description": "Paragraphs, UI labels, captions."
      },
      "mono": {
        "value": "'Geist Mono', 'Fira Code', ui-monospace, monospace",
        "description": "Code, tokens, technical metadata."
      }
    },
    "scale": {
      "display": { "size": "82px", "lineHeight": "1.0",  "letterSpacing": "-0.04em", "weight": 500, "family": "display" },
      "h1":      { "size": "58px", "lineHeight": "1.05", "letterSpacing": "-0.03em", "weight": 500, "family": "display" },
      "h2":      { "size": "38px", "lineHeight": "1.1",  "letterSpacing": "-0.02em", "weight": 500, "family": "display" },
      "h3":      { "size": "28px", "lineHeight": "1.3",  "letterSpacing": "-0.01em", "weight": 500, "family": "display" },
      "h4":      { "size": "20px", "lineHeight": "1.35", "weight": 600, "family": "body" },
      "body":    { "size": "16px", "lineHeight": "1.65", "weight": 400, "family": "body" },
      "small":   { "size": "14px", "lineHeight": "1.6",  "weight": 400, "family": "body" },
      "mono":    { "size": "14px", "lineHeight": "1.6",  "weight": 400, "family": "mono" }
    }
  },
  "motion": {
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring":  "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "out":     "cubic-bezier(0, 0, 0.2, 1)"
    },
    "duration": {
      "fast":    "100ms",
      "default": "180ms",
      "medium":  "240ms",
      "slow":    "320ms"
    }
  }
}
